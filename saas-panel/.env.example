# Panel SaaS — Environment Variables (copy to .env and fill)

# Next.js app base URL (internal API target)
API_BASE_URL=http://127.0.0.1:3000

# Internal API key (same value as INTERNAL_API_KEY in Next.js .env.local)
INTERNAL_API_KEY=

# MySQL panel database (operational data: admin/auth/audit)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=saas_panel
DB_USER=root
DB_PASS=

# Session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Environment (development / production)
APP_ENV=development
